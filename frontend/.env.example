VITE_BACKEND_URL=http://localhost:4000/api
VITE_NETWORK=localhost
VITE_DEV_WALLETS=true
# Optional. JSON-RPC used for reads before a wallet is connected.
# Defaults to http://127.0.0.1:8545 on localhost; required for sepolia.
VITE_RPC_URL=
# Optional. First block to scan for history events. Defaults to deployBlock from
# the deployment file, or 0.
VITE_LOGS_FROM_BLOCK=
